{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://weflow.local/contracts/v1/qq-group-pairing-challenge.schema.json",
  "title": "QQGroupPairingChallenge",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "challenge_id", "challenge_sha256", "app_id_hash", "tenant_id", "tenant_id_hash", "capability_profile_hash", "created_at", "deadline_at", "status"],
  "properties": {
    "schema_id": {"const": "https://weflow.local/contracts/v1/qq-group-pairing-challenge.schema.json"},
    "schema_version": {"const": "v1"},
    "challenge_id": {"type": "string", "pattern": "^qqpc_[a-f0-9]{32}$"},
    "challenge_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "app_id_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "tenant_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "tenant_id_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "capability_profile_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "created_at": {"type": "string", "minLength": 1},
    "deadline_at": {"type": "string", "minLength": 1},
    "status": {"enum": ["PENDING", "EXPIRED", "CANCELLED", "CONFLICT"]}
  }
}
