{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://weflow.local/contracts/v1/qq-handler-approval-decision.schema.json",
  "title": "QQHandlerApprovalDecision",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "approval_decision_id", "approval_request_id", "tenant_id", "case_id", "case_revision_id", "handler_binding_id", "candidate_revision_id", "candidate_sha256", "workflow_version", "decision", "author_identity_hash", "group_openid_hash", "source_message_id", "source_message_id_hash", "reason_code", "decided_at", "expires_at"],
  "properties": {
    "schema_id": {"const": "https://weflow.local/contracts/v1/qq-handler-approval-decision.schema.json"},
    "schema_version": {"const": "v1"},
    "approval_decision_id": {"type": "string", "pattern": "^qqhad_[a-f0-9]{32}$"},
    "approval_request_id": {"type": "string", "pattern": "^qqhar_[a-f0-9]{32}$"},
    "tenant_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "case_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "case_revision_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "handler_binding_id": {"type": "string", "pattern": "^qqhbind_[a-f0-9]{32}$"},
    "candidate_revision_id": {"type": "string", "pattern": "^qqhcr_[a-f0-9]{32}$"},
    "candidate_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "workflow_version": {"type": "integer", "minimum": 1},
    "decision": {"const": "approved"},
    "author_identity_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "group_openid_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "source_message_id": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\x00-\\x1F\\x7F]+$"},
    "source_message_id_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "reason_code": {"type": "string", "minLength": 1, "maxLength": 128},
    "decided_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"}
  }
}
