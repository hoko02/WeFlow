{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://weflow.local/contracts/v1/case.schema.json",
  "title": "Case",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "tenant_id", "case_id", "created_at"],
  "properties": {
    "schema_id": {"const": "https://weflow.local/contracts/v1/case.schema.json"},
    "schema_version": {"const": "v1"},
    "tenant_id": {"type": "string", "minLength": 1},
    "case_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "minLength": 1},
    "source_event_id": {"type": "string", "minLength": 1},
    "correlation_id": {"type": "string", "minLength": 1},
    "channel": {"type": "string", "minLength": 1},
    "conversation_id": {"type": "string", "minLength": 1},
    "customer_id": {"type": "string", "minLength": 1}
  }
}
