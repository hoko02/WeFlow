{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://weflow.local/contracts/v1/replay-request.schema.json",
  "title": "ReplayRequest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "tenant_id", "replay_request_id", "fixture_id", "mode", "requested_at"],
  "properties": {
    "schema_id": {"const": "https://weflow.local/contracts/v1/replay-request.schema.json"},
    "schema_version": {"const": "v1"},
    "tenant_id": {"type": "string", "minLength": 1},
    "replay_request_id": {"type": "string", "minLength": 1},
    "fixture_id": {"type": "string", "minLength": 1},
    "mode": {"const": "replay"},
    "requested_at": {"type": "string", "minLength": 1},
    "fault_profile": {"type": ["string", "null"]}
  }
}
