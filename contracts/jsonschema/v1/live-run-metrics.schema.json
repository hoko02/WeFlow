  "properties": {
    "schema_id": {"const": "https://weflow.local/contracts/v1/live-run-metrics.schema.json"}, "schema_version": {"const": "v1"}, "tenant_id": {"type": "string", "minLength": 1}, "live_run_metrics_id": {"type": "string", "minLength": 1}, "suite_id": {"const": "live-pilot.v1"}, "evaluation_task_id": {"type": "string", "minLength": 1}, "attempt_id": {"type": "string", "minLength": 1}, "price_profile_id": {"type": "string", "minLength": 1}, "price_profile_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "model_id_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "invocation_count": {"type": "integer", "minimum": 0}, "successful_invocation_count": {"type": "integer", "minimum": 0}, "failed_invocation_count": {"type": "integer", "minimum": 0}, "valid_proposal_count": {"type": "integer", "minimum": 0}, "action_count": {"type": "integer", "minimum": 0}, "tool_call_count": {"type": "integer", "minimum": 0}, "input_tokens": {"type": "integer", "minimum": 0}, "output_tokens": {"type": "integer", "minimum": 0}, "total_tokens": {"type": "integer", "minimum": 0}, "estimated_cost": {"type": "number", "minimum": 0}, "currency": {"type": "string", "pattern": "^[A-Z]{3}$"}, "provider_latency_ms": {"type": "integer", "minimum": 0}, "end_to_end_latency_ms": {"type": "integer", "minimum": 0}, "wall_time_ms": {"type": "integer", "minimum": 0}, "retry_count": {"type": "integer", "minimum": 0}, "no_progress_count": {"type": "integer", "minimum": 0}, "terminal_outcome": {"enum": ["response_ready", "needs_information", "needs_operator", "tool_timeout", "budget_exhausted", "malformed_model_output", "policy_denied", "provider_outcome_unknown"]}, "failure_attribution": {"type": ["string", "null"], "enum": [null, "configuration", "provider_network", "model_output", "model_quality", "harness_policy", "harness_verifier", "tool_fault", "budget", "evaluator_integrity"]}, "external_business_write_count": {"const": 0},
    "capability_flags": {"type": "object", "additionalProperties": false, "required": ["live", "replay", "network", "model", "external_business_write", "approval", "delivery", "customer_outcome_unverified"], "properties": {"live": {"const": true}, "replay": {"const": false}, "network": {"const": true}, "model": {"const": true}, "external_business_write": {"const": false}, "approval": {"const": false}, "delivery": {"const": false}, "customer_outcome_unverified": {"const": true}}},
    "metrics_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
