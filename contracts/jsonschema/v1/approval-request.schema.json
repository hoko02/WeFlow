{
    "$schema":  "https://json-schema.org/draft/2020-12/schema",
    "$id":  "https://weflow.local/contracts/v1/approval-request.schema.json",
    "title":  "ApprovalRequest",
    "type":  "object",
    "additionalProperties":  false,
    "required":  [
                     "schema_id",
                     "schema_version",
                     "tenant_id",
                     "approval_request_id",
                     "case_id",
                     "case_revision_id",
                     "candidate_hash",
                     "policy_decision_id",
                     "evidence_hashes",
                     "created_at",
                     "expires_at"
                 ],
    "properties":  {
                       "schema_id":  {
                                         "const":  "https://weflow.local/contracts/v1/approval-request.schema.json"
                                     },
                       "schema_version":  {
                                              "const":  "v1"
                                          },
                       "tenant_id":  {
                                         "type":  "string",
                                         "minLength":  1
                                     },
                       "approval_request_id":  {
                                                   "type":  "string",
                                                   "minLength":  1
                                               },
                       "case_id":  {
                                       "type":  "string",
                                       "minLength":  1
                                   },
                       "case_revision_id":  {
                                                "type":  "string",
                                                "minLength":  1
                                            },
                       "candidate_hash":  {
                                              "type":  "string",
                                              "pattern":  "^[A-Fa-f0-9]{64}$"
                                          },
                       "policy_decision_id":  {
                                                  "type":  "string",
                                                  "minLength":  1
                                              },
                       "evidence_hashes":  {
                                               "type":  "array",
                                               "minItems":  1,
                                               "items":  {
                                                             "type":  "string",
                                                             "pattern":  "^[A-Fa-f0-9]{64}$"
                                                         }
                                           },
                       "created_at":  {
                                          "type":  "string",
                                          "minLength":  1
                                      },
                       "expires_at":  {
                                          "type":  "string",
                                          "minLength":  1
                                      },
                       "workflow_id":  {
                                           "minLength":  1,
                                           "type":  "string"
                                       },
                       "checkpoint_id":  {
                                             "minLength":  1,
                                             "type":  "string"
                                         },
                       "workflow_version":  {
                                                "type":  "integer",
                                                "minimum":  0
                                            },
                       "authorization_binding_sha256":  {
                                                            "type":  "string",
                                                            "pattern":  "^[a-f0-9]{64}$"
                                                        },
                       "policy_decision_sha256":  {
                                                      "type":  "string",
                                                      "pattern":  "^[a-f0-9]{64}$"
                                                  },
                       "policy_version":  {
                                              "minLength":  1,
                                              "type":  "string"
                                          },
                       "grant_sha256":  {
                                            "type":  "string",
                                            "pattern":  "^[a-f0-9]{64}$"
                                        }
                   }
}
