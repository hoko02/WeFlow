{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://weflow.local/contracts/v1/response-candidate.schema.json",
  "title": "ResponseCandidate",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "tenant_id", "case_id", "case_revision_id", "workflow_id", "checkpoint_id", "context_manifest_id", "candidate_id", "context_sha256", "evidence_hashes", "candidate_sha256", "risk", "next_step", "created_at"],
  "properties": {
    "schema_id": {"const": "https://weflow.local/contracts/v1/response-candidate.schema.json"},
    "schema_version": {"const": "v1"},
    "tenant_id": {"type": "string", "minLength": 1},
    "case_id": {"type": "string", "minLength": 1},
    "case_revision_id": {"type": "string", "minLength": 1},
    "workflow_id": {"type": "string", "minLength": 1},
    "checkpoint_id": {"type": "string", "minLength": 1},
    "context_manifest_id": {"type": "string", "minLength": 1},
    "candidate_id": {"type": "string", "minLength": 1},
    "context_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "evidence_hashes": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "uniqueItems": true},
    "candidate_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "risk": {"enum": ["low", "medium", "high"]},
    "next_step": {"enum": ["operator_review", "awaiting_information"]},
    "created_at": {"type": "string", "minLength": 1}
  }
}
