{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://weflow.local/contracts/v1/qq-model-case-budget.schema.json",
  "title": "QQModelCaseBudget",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "budget_id", "budget_sha256", "tenant_id", "case_id", "case_revision_id", "assist_request_id", "handler_binding_id", "profile_sha256", "reserved", "used", "pessimistic_unknown_accounted", "recorded_at"],
  "properties": {
    "schema_id": {"const": "https://weflow.local/contracts/v1/qq-model-case-budget.schema.json"},
    "schema_version": {"const": "v1"},
    "budget_id": {"type": "string", "pattern": "^qqmab_[a-f0-9]{32}$"},
    "budget_sha256": {"$ref": "#/$defs/hash"},
    "tenant_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "case_id": {"type": "string", "pattern": "^case_[a-f0-9]{24,64}$"},
    "case_revision_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "assist_request_id": {"type": "string", "pattern": "^qqmar_[a-f0-9]{32}$"},
    "handler_binding_id": {"type": "string", "pattern": "^qqhbind_[a-f0-9]{32}$"},
    "profile_sha256": {"$ref": "#/$defs/hash"},
    "reserved": {"$ref": "#/$defs/usage"},
    "used": {"$ref": "#/$defs/usage"},
    "pessimistic_unknown_accounted": {"type": "boolean"},
    "recorded_at": {"type": "string", "minLength": 20, "maxLength": 40}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "usage": {"type": "object", "additionalProperties": false, "required": ["provider_calls", "input_tokens", "output_tokens", "total_tokens", "tool_calls", "actions", "no_progress", "wall_time_ms", "estimated_cost"], "properties": {"provider_calls": {"type": "integer", "minimum": 0}, "input_tokens": {"type": "integer", "minimum": 0}, "output_tokens": {"type": "integer", "minimum": 0}, "total_tokens": {"type": "integer", "minimum": 0}, "tool_calls": {"type": "integer", "minimum": 0}, "actions": {"type": "integer", "minimum": 0}, "no_progress": {"type": "integer", "minimum": 0}, "wall_time_ms": {"type": "integer", "minimum": 0}, "estimated_cost": {"type": "number", "minimum": 0}}}
  }
}
