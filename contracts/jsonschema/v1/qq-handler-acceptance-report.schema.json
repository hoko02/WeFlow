{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://weflow.local/contracts/v1/qq-handler-acceptance-report.schema.json",
  "title": "QQHandlerAcceptanceReport",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "report_type", "report_id", "report_sha256", "mode", "app_id_hash", "tenant_id_hash", "group_openid_hash", "handler_binding_id", "assurance_level", "dual_surface_binding_verified", "notification_status", "notification_attempt_count", "private_workflow_verified", "group_approval_verified", "final_provider_accepted", "recovery_state", "duplicate_event_count", "rejected_event_count", "artifact_deletion_verified", "network_contacted", "external_write_attempted", "model_invocation", "customer_receipt_verified", "issue_resolution", "case_completion", "production_ready"],
  "properties": {
    "schema_id": {"const": "https://weflow.local/contracts/v1/qq-handler-acceptance-report.schema.json"},
    "schema_version": {"const": "v1"},
    "report_type": {"const": "weflow-qq-handler-acceptance.v1"},
    "report_id": {"type": "string", "pattern": "^qqharp_[a-f0-9]{32}$"},
    "report_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "mode": {"enum": ["offline-fake", "readiness", "qq-sandbox-live"]},
    "app_id_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "tenant_id_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "group_openid_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "handler_binding_id": {"type": ["string", "null"], "pattern": "^qqhbind_[a-f0-9]{32}$"},
    "assurance_level": {"type": ["string", "null"], "enum": [null, "operator_confirmed_dual_challenge", "provider_cross_surface_verified"]},
    "dual_surface_binding_verified": {"type": "boolean"},
    "notification_status": {"enum": ["not_attempted", "accepted", "rejected", "rate_limited", "timed_out", "disconnected", "unknown"]},
    "notification_attempt_count": {"type": "integer", "minimum": 0, "maximum": 1},
    "private_workflow_verified": {"type": "boolean"},
    "group_approval_verified": {"type": "boolean"},
    "final_provider_accepted": {"type": "boolean"},
    "recovery_state": {"enum": ["not_required", "reconciled", "ambiguous_no_retry", "expired_no_fallback"]},
    "duplicate_event_count": {"type": "integer", "minimum": 0},
    "rejected_event_count": {"type": "integer", "minimum": 0},
    "artifact_deletion_verified": {"type": "boolean"},
    "network_contacted": {"type": "boolean"},
    "external_write_attempted": {"type": "boolean"},
    "model_invocation": {"const": false},
    "customer_receipt_verified": {"const": false},
    "issue_resolution": {"const": false},
    "case_completion": {"const": false},
    "production_ready": {"const": false}
  }
}
