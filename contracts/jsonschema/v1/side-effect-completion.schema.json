{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://weflow.local/contracts/v1/side-effect-completion.schema.json",
  "title": "SideEffectCompletion",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "tenant_id", "case_id", "case_revision_id", "workflow_id", "checkpoint_id", "completion_id", "intent_id", "observation_id", "observed_ticket_id", "observed_version", "result_sha256", "completed_at"],
  "properties": {
    "schema_id": {"const": "https://weflow.local/contracts/v1/side-effect-completion.schema.json"},
    "schema_version": {"const": "v1"},
    "tenant_id": {"type": "string", "minLength": 1},
    "case_id": {"type": "string", "minLength": 1},
    "case_revision_id": {"type": "string", "minLength": 1},
    "workflow_id": {"type": "string", "minLength": 1},
    "checkpoint_id": {"type": "string", "minLength": 1},
    "completion_id": {"type": "string", "minLength": 1},
    "intent_id": {"type": "string", "minLength": 1},
    "observation_id": {"type": "string", "minLength": 1},
    "observed_ticket_id": {"type": "string", "minLength": 1},
    "observed_version": {"type": "integer", "minimum": 1},
    "result_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "completed_at": {"type": "string", "minLength": 1}
  }
}
