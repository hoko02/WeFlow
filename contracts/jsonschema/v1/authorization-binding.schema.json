{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://weflow.local/contracts/v1/authorization-binding.schema.json",
  "title": "AuthorizationBinding",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "tenant_id", "authorization_binding_id", "authorization_binding_sha256", "case_id", "case_revision_id", "workflow_id", "checkpoint_id", "workflow_version", "candidate_hash", "evidence_hashes", "action", "policy_decision_id", "policy_version", "policy_decision_sha256", "grant_id", "grant_version", "grant_sha256", "subject_id", "role", "delivery_resource_id", "delivery_resource_scope", "data_classification", "remaining_budget", "expires_at", "created_at"],
  "properties": {
    "schema_id": {"const": "https://weflow.local/contracts/v1/authorization-binding.schema.json"},
    "schema_version": {"const": "v1"},
    "tenant_id": {"type": "string", "minLength": 1},
    "authorization_binding_id": {"type": "string", "minLength": 1},
    "authorization_binding_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "case_id": {"type": "string", "minLength": 1},
    "case_revision_id": {"type": "string", "minLength": 1},
    "workflow_id": {"type": "string", "minLength": 1},
    "checkpoint_id": {"type": "string", "minLength": 1},
    "workflow_version": {"type": "integer", "minimum": 0},
    "candidate_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "evidence_hashes": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[a-f0-9]{64}$"}},
    "action": {"enum": ["approval.request", "approval.decide", "outbound_delivery.execute"]},
    "policy_decision_id": {"type": "string", "minLength": 1},
    "policy_version": {"type": "string", "minLength": 1},
    "policy_decision_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "grant_id": {"type": "string", "minLength": 1},
    "grant_version": {"type": "string", "minLength": 1},
    "grant_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "subject_id": {"type": "string", "minLength": 1},
    "role": {"type": "string", "minLength": 1},
    "delivery_resource_id": {"type": "string", "minLength": 1},
    "delivery_resource_scope": {"type": "string", "minLength": 1},
    "data_classification": {"enum": ["synthetic", "unsafe_instruction", "secret", "raw_private"]},
    "remaining_budget": {"type": "integer", "minimum": 0},
    "expires_at": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "minLength": 1}
  }
}