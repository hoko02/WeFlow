{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://weflow.local/contracts/v1/qq-handler-passive-reply-intent.schema.json",
  "title": "QQHandlerPassiveReplyIntent",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "intent_id", "operation", "surface", "response_kind", "tenant_id", "case_id", "case_revision_id", "handler_binding_id", "workflow_version", "source_message_id", "source_message_id_hash", "reply_msg_seq", "content_artifact_id", "content_sha256", "natural_key", "idempotency_key", "reply_deadline_at", "approval_decision_id", "created_at"],
  "properties": {
    "schema_id": {"const": "https://weflow.local/contracts/v1/qq-handler-passive-reply-intent.schema.json"},
    "schema_version": {"const": "v1"},
    "intent_id": {"type": "string", "pattern": "^qqhpi_[a-f0-9]{32}$"},
    "operation": {"enum": ["qq.c2c.passive_reply.execute", "qq.final_reply.execute"]},
    "surface": {"enum": ["c2c", "group"]},
    "response_kind": {"enum": ["pull", "accept", "draft-preview", "reject", "group-nudge", "final"]},
    "tenant_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "case_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "case_revision_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "handler_binding_id": {"type": "string", "pattern": "^qqhbind_[a-f0-9]{32}$"},
    "workflow_version": {"type": "integer", "minimum": 1},
    "source_message_id": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\x00-\\x1F\\x7F]+$"},
    "source_message_id_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "reply_msg_seq": {"type": "integer", "minimum": 1, "maximum": 5},
    "content_artifact_id": {"type": ["string", "null"], "pattern": "^qqa_[a-f0-9]{32}$"},
    "content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "natural_key": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "idempotency_key": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "reply_deadline_at": {"type": "string", "format": "date-time"},
    "approval_decision_id": {"type": ["string", "null"], "pattern": "^qqhad_[a-f0-9]{32}$"},
    "created_at": {"type": "string", "format": "date-time"}
  }
}
