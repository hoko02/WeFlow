{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://weflow.local/contracts/v1/model-invocation-intent.schema.json",
  "title": "ModelInvocationIntent",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "tenant_id", "evaluation_session_id", "suite_id", "evaluation_task_id", "attempt_id", "logical_turn_id", "invocation_id", "context_manifest_id", "context_sha256", "prompt_template_id", "prompt_template_sha256", "source_sha256s", "provider_profile_id", "provider_profile_sha256", "model_id_sha256", "price_profile_id", "price_profile_sha256", "reservation", "created_at", "intent_sha256"],
  "properties": {
    "schema_id": {"const": "https://weflow.local/contracts/v1/model-invocation-intent.schema.json"},
    "schema_version": {"const": "v1"},
    "tenant_id": {"type": "string", "minLength": 1},
    "evaluation_session_id": {"type": "string", "minLength": 1},
    "suite_id": {"const": "live-pilot.v1"},
    "evaluation_task_id": {"type": "string", "minLength": 1},
    "attempt_id": {"type": "string", "minLength": 1},
    "logical_turn_id": {"type": "string", "minLength": 1},
    "invocation_id": {"type": "string", "minLength": 1},
    "context_manifest_id": {"type": "string", "minLength": 1},
    "context_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "prompt_template_id": {"type": "string", "minLength": 1},
    "prompt_template_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "source_sha256s": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-f0-9]{64}$"}},
    "provider_profile_id": {"type": "string", "minLength": 1},
    "provider_profile_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "model_id_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "price_profile_id": {"type": "string", "minLength": 1},
    "price_profile_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "reservation": {
      "type": "object", "additionalProperties": false,
      "required": ["call_count", "input_tokens", "output_tokens", "total_tokens", "estimated_cost", "wall_time_ms", "request_timeout_ms"],
      "properties": {
        "call_count": {"const": 1}, "input_tokens": {"type": "integer", "minimum": 1}, "output_tokens": {"type": "integer", "minimum": 1}, "total_tokens": {"type": "integer", "minimum": 2}, "estimated_cost": {"type": "number", "minimum": 0}, "wall_time_ms": {"type": "integer", "minimum": 1}, "request_timeout_ms": {"type": "integer", "minimum": 1}
      }
    },
    "created_at": {"type": "string", "minLength": 1},
    "intent_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
