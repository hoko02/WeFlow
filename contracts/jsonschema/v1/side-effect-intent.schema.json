{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://weflow.local/contracts/v1/side-effect-intent.schema.json",
  "title": "SideEffectIntent",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "tenant_id", "case_id", "case_revision_id", "workflow_id", "checkpoint_id", "intent_id", "effect_kind", "operation", "natural_key", "intended_state_hash", "idempotency_key", "evidence_references", "correlation_id", "created_at"],
  "properties": {
    "schema_id": {"const": "https://weflow.local/contracts/v1/side-effect-intent.schema.json"},
    "schema_version": {"const": "v1"},
    "tenant_id": {"type": "string", "minLength": 1},
    "case_id": {"type": "string", "minLength": 1},
    "case_revision_id": {"type": "string", "minLength": 1},
    "workflow_id": {"type": "string", "minLength": 1},
    "checkpoint_id": {"type": "string", "minLength": 1},
    "intent_id": {"type": "string", "minLength": 1},
    "effect_kind": {"const": "fixture-local-ticket"},
    "operation": {"enum": ["find-or-create", "workflow-handoff"]},
    "natural_key": {"type": "string", "minLength": 1},
    "intended_state_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "idempotency_key": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "evidence_references": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "correlation_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "minLength": 1}
  }
}
