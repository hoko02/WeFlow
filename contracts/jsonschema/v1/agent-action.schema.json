{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://weflow.local/contracts/v1/agent-action.schema.json",
  "title": "AgentAction",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "tenant_id", "case_id", "case_revision_id", "workflow_id", "checkpoint_id", "context_manifest_id", "step_id", "action_type", "action_sha256", "created_at"],
  "properties": {
    "schema_id": {"const": "https://weflow.local/contracts/v1/agent-action.schema.json"},
    "schema_version": {"const": "v1"},
    "tenant_id": {"type": "string", "minLength": 1},
    "case_id": {"type": "string", "minLength": 1},
    "case_revision_id": {"type": "string", "minLength": 1},
    "workflow_id": {"type": "string", "minLength": 1},
    "checkpoint_id": {"type": "string", "minLength": 1},
    "context_manifest_id": {"type": "string", "minLength": 1},
    "step_id": {"type": "string", "minLength": 1},
    "action_type": {"enum": ["read_crm", "read_monitoring", "read_knowledge", "needs_information", "needs_operator", "response_candidate"]},
    "action_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "created_at": {"type": "string", "minLength": 1}
  }
}
