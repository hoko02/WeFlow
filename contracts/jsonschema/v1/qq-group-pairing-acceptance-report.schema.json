{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://weflow.local/contracts/v1/qq-group-pairing-acceptance-report.schema.json",
  "title": "QQGroupPairingAcceptanceReport",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "report_id", "report_sha256", "mode", "accepted", "fake_pairing_verified", "qq_group_pairing_live_verified", "pairing_id", "app_id_hash", "group_openid_hash", "tenant_id_hash", "completion_status", "reason_code", "observed_event_count", "rejected_event_count", "duplicate_event_count", "case_creation", "workflow_activation", "qq_write_attempted", "acknowledgement_sent", "model_invocation", "handler_binding", "customer_receipt_verified", "issue_resolution", "case_completion", "production_ready", "stage1_verified", "network_required", "credentials_required", "privacy"],
  "properties": {
    "schema_id": {"const": "https://weflow.local/contracts/v1/qq-group-pairing-acceptance-report.schema.json"},
    "schema_version": {"const": "v1"},
    "report_id": {"type": "string", "pattern": "^qqpr_[a-f0-9]{32}$"},
    "report_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "mode": {"enum": ["offline-fake", "qq-sandbox-live"]},
    "accepted": {"type": "boolean"},
    "fake_pairing_verified": {"type": "boolean"},
    "qq_group_pairing_live_verified": {"type": "boolean"},
    "pairing_id": {"type": ["string", "null"], "pattern": "^qqpair_[a-f0-9]{32}$"},
    "app_id_hash": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "group_openid_hash": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "tenant_id_hash": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "completion_status": {"enum": ["COMPLETED", "EXPIRED", "CANCELLED", "CONFLICT", "REVOKED", "NOT_COMPLETED"]},
    "reason_code": {"type": "string", "minLength": 1, "maxLength": 128},
    "observed_event_count": {"type": "integer", "minimum": 0},
    "rejected_event_count": {"type": "integer", "minimum": 0},
    "duplicate_event_count": {"type": "integer", "minimum": 0},
    "case_creation": {"const": false},
    "workflow_activation": {"const": false},
    "qq_write_attempted": {"const": false},
    "acknowledgement_sent": {"const": false},
    "model_invocation": {"const": false},
    "handler_binding": {"const": false},
    "customer_receipt_verified": {"const": false},
    "issue_resolution": {"const": false},
    "case_completion": {"const": false},
    "production_ready": {"const": false},
    "stage1_verified": {"const": false},
    "network_required": {"type": "boolean"},
    "credentials_required": {"type": "boolean"},
    "privacy": {
      "type": "object", "additionalProperties": false,
      "required": ["challenge_plaintext_persisted", "raw_group_in_report", "member_identity_persisted", "provider_event_persisted", "credential_persisted"],
      "properties": {
        "challenge_plaintext_persisted": {"const": false},
        "raw_group_in_report": {"const": false},
        "member_identity_persisted": {"const": false},
        "provider_event_persisted": {"const": false},
        "credential_persisted": {"const": false}
      }
    }
  }
}
