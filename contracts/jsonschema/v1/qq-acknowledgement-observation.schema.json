{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://weflow.local/contracts/v1/qq-acknowledgement-observation.schema.json",
  "title": "QQAcknowledgementObservation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id", "schema_version", "tenant_id", "case_id", "case_revision_id",
    "observation_id", "intent_id", "status", "provider_message_id_hash",
    "outcome_sha256", "reason_code", "recorded_at"
  ],
  "properties": {
    "schema_id": {"const": "https://weflow.local/contracts/v1/qq-acknowledgement-observation.schema.json"},
    "schema_version": {"const": "v1"},
    "tenant_id": {"type": "string", "minLength": 1},
    "case_id": {"type": "string", "minLength": 1},
    "case_revision_id": {"type": "string", "minLength": 1},
    "observation_id": {"type": "string", "minLength": 1},
    "intent_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["absent", "accepted", "present", "duplicate", "unknown", "conflict", "expired", "unauthorized"]},
    "provider_message_id_hash": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "outcome_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "reason_code": {"type": "string", "minLength": 1, "maxLength": 128},
    "recorded_at": {"type": "string", "minLength": 1}
  }
}
