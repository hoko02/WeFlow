{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://weflow.local/contracts/v1/qq-model-assist-context.schema.json",
  "title": "QQModelAssistContext",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "context_id", "context_sha256", "tenant_id", "case_id", "case_revision_id", "handler_binding_id", "assist_request_id", "issue_artifact_id", "issue_content_sha256", "issue_view_sha256", "issue_view_length", "issue_classification", "source_profile_sha256", "ordered_source_sha256s", "prompt_template_sha256", "policy_profile_sha256", "provider_profile_sha256", "price_profile_sha256", "qq_capability_profile_hash", "model_capability_profile_hash", "budget_profile_sha256", "created_at"],
  "properties": {
    "schema_id": {"const": "https://weflow.local/contracts/v1/qq-model-assist-context.schema.json"},
    "schema_version": {"const": "v1"},
    "context_id": {"type": "string", "pattern": "^qqmacx_[a-f0-9]{32}$"},
    "context_sha256": {"$ref": "#/$defs/hash"},
    "tenant_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "case_id": {"type": "string", "pattern": "^case_[a-f0-9]{24,64}$"},
    "case_revision_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "handler_binding_id": {"type": "string", "pattern": "^qqhbind_[a-f0-9]{32}$"},
    "assist_request_id": {"type": "string", "pattern": "^qqmar_[a-f0-9]{32}$"},
    "issue_artifact_id": {"type": "string", "pattern": "^qqa_[a-f0-9]{32}$"},
    "issue_content_sha256": {"$ref": "#/$defs/hash"},
    "issue_view_sha256": {"$ref": "#/$defs/hash"},
    "issue_view_length": {"type": "integer", "minimum": 1, "maximum": 1200},
    "issue_classification": {"const": "untrusted_redacted_qq_issue"},
    "source_profile_sha256": {"$ref": "#/$defs/hash"},
    "ordered_source_sha256s": {"type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true, "items": {"$ref": "#/$defs/hash"}},
    "prompt_template_sha256": {"$ref": "#/$defs/hash"},
    "policy_profile_sha256": {"$ref": "#/$defs/hash"},
    "provider_profile_sha256": {"$ref": "#/$defs/hash"},
    "price_profile_sha256": {"$ref": "#/$defs/hash"},
    "qq_capability_profile_hash": {"$ref": "#/$defs/hash"},
    "model_capability_profile_hash": {"$ref": "#/$defs/hash"},
    "budget_profile_sha256": {"$ref": "#/$defs/hash"},
    "created_at": {"type": "string", "minLength": 20, "maxLength": 40}
  },
  "$defs": {"hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
