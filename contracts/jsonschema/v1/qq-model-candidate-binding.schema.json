{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://weflow.local/contracts/v1/qq-model-candidate-binding.schema.json",
  "title": "QQModelCandidateBinding",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "binding_id", "binding_sha256", "tenant_id", "case_id", "case_revision_id", "workflow_version", "handler_binding_id", "assist_request_id", "context_id", "context_sha256", "invocation_id", "invocation_evidence_sha256", "action_sha256", "ordered_evidence_sha256s", "verifier_outcome_id", "verifier_outcome_sha256", "budget_sha256", "issue_artifact_id", "issue_content_sha256", "candidate_artifact_id", "candidate_revision_id", "candidate_sha256", "approval_request_id", "policy_profile_sha256", "qq_capability_profile_hash", "model_capability_profile_hash", "provider_profile_sha256", "prompt_template_sha256", "price_profile_sha256", "status", "created_at"],
  "properties": {
    "schema_id": {"const": "https://weflow.local/contracts/v1/qq-model-candidate-binding.schema.json"},
    "schema_version": {"const": "v1"},
    "binding_id": {"type": "string", "pattern": "^qqmcb_[a-f0-9]{32}$"},
    "binding_sha256": {"$ref": "#/$defs/hash"},
    "tenant_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "case_id": {"type": "string", "pattern": "^case_[a-f0-9]{24,64}$"},
    "case_revision_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "workflow_version": {"type": "integer", "minimum": 2},
    "handler_binding_id": {"type": "string", "pattern": "^qqhbind_[a-f0-9]{32}$"},
    "assist_request_id": {"type": "string", "pattern": "^qqmar_[a-f0-9]{32}$"},
    "context_id": {"type": "string", "pattern": "^qqmacx_[a-f0-9]{32}$"},
    "context_sha256": {"$ref": "#/$defs/hash"},
    "invocation_id": {"type": "string", "pattern": "^qqmai_[a-f0-9]{32}$"},
    "invocation_evidence_sha256": {"$ref": "#/$defs/hash"},
    "action_sha256": {"$ref": "#/$defs/hash"},
    "ordered_evidence_sha256s": {"type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true, "items": {"$ref": "#/$defs/hash"}},
    "verifier_outcome_id": {"type": "string", "pattern": "^qqmvo_[a-f0-9]{32}$"},
    "verifier_outcome_sha256": {"$ref": "#/$defs/hash"},
    "budget_sha256": {"$ref": "#/$defs/hash"},
    "issue_artifact_id": {"type": "string", "pattern": "^qqa_[a-f0-9]{32}$"},
    "issue_content_sha256": {"$ref": "#/$defs/hash"},
    "candidate_artifact_id": {"type": "string", "pattern": "^qqa_[a-f0-9]{32}$"},
    "candidate_revision_id": {"type": "string", "pattern": "^qqhcr_[a-f0-9]{32}$"},
    "candidate_sha256": {"$ref": "#/$defs/hash"},
    "approval_request_id": {"type": "string", "pattern": "^qqhar_[a-f0-9]{32}$"},
    "policy_profile_sha256": {"$ref": "#/$defs/hash"},
    "qq_capability_profile_hash": {"$ref": "#/$defs/hash"},
    "model_capability_profile_hash": {"$ref": "#/$defs/hash"},
    "provider_profile_sha256": {"$ref": "#/$defs/hash"},
    "prompt_template_sha256": {"$ref": "#/$defs/hash"},
    "price_profile_sha256": {"$ref": "#/$defs/hash"},
    "status": {"enum": ["CURRENT", "INVALIDATED", "DELETED"]},
    "created_at": {"type": "string", "minLength": 20, "maxLength": 40}
  },
  "$defs": {"hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
