{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://weflow.local/contracts/v1/qq-model-invocation-evidence.schema.json",
  "title": "QQModelInvocationEvidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "invocation_id", "logical_turn_id", "assist_request_id", "context_id", "context_sha256", "tenant_id", "case_id", "case_revision_id", "handler_binding_id", "intent_sha256", "observation_id", "status", "request_reference_sha256", "response_sha256", "provider_profile_sha256", "model_id_sha256", "price_profile_sha256", "reservation", "usage", "provider_latency_ms", "estimated_cost", "failure_classification", "intent_created_at", "observed_at", "evidence_sha256"],
  "properties": {
    "schema_id": {"const": "https://weflow.local/contracts/v1/qq-model-invocation-evidence.schema.json"},
    "schema_version": {"const": "v1"},
    "invocation_id": {"type": "string", "pattern": "^qqmai_[a-f0-9]{32}$"},
    "logical_turn_id": {"type": "string", "pattern": "^qqmat_[a-f0-9]{32}$"},
    "assist_request_id": {"type": "string", "pattern": "^qqmar_[a-f0-9]{32}$"},
    "context_id": {"type": "string", "pattern": "^qqmacx_[a-f0-9]{32}$"},
    "context_sha256": {"$ref": "#/$defs/hash"},
    "tenant_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "case_id": {"type": "string", "pattern": "^case_[a-f0-9]{24,64}$"},
    "case_revision_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "handler_binding_id": {"type": "string", "pattern": "^qqhbind_[a-f0-9]{32}$"},
    "intent_sha256": {"$ref": "#/$defs/hash"},
    "observation_id": {"type": ["string", "null"], "pattern": "^qqmao_[a-f0-9]{32}$"},
    "status": {"enum": ["intent_recorded", "completed", "retryable_error", "provider_outcome_unknown", "malformed_model_output"]},
    "request_reference_sha256": {"anyOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]},
    "response_sha256": {"anyOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]},
    "provider_profile_sha256": {"$ref": "#/$defs/hash"},
    "model_id_sha256": {"$ref": "#/$defs/hash"},
    "price_profile_sha256": {"$ref": "#/$defs/hash"},
    "reservation": {"$ref": "#/$defs/tokens"},
    "usage": {"$ref": "#/$defs/tokens"},
    "provider_latency_ms": {"type": "integer", "minimum": 0},
    "estimated_cost": {"type": "number", "minimum": 0},
    "failure_classification": {"type": ["string", "null"], "minLength": 1, "maxLength": 96, "pattern": "^[a-z0-9._-]+$"},
    "intent_created_at": {"type": "string", "minLength": 20, "maxLength": 40},
    "observed_at": {"type": ["string", "null"], "minLength": 20, "maxLength": 40},
    "evidence_sha256": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "tokens": {"type": "object", "additionalProperties": false, "required": ["input_tokens", "output_tokens", "total_tokens"], "properties": {"input_tokens": {"type": "integer", "minimum": 0}, "output_tokens": {"type": "integer", "minimum": 0}, "total_tokens": {"type": "integer", "minimum": 0}}}
  }
}
