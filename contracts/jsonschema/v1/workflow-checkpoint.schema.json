{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://weflow.local/contracts/v1/workflow-checkpoint.schema.json",
  "title": "WorkflowCheckpoint",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "tenant_id", "case_id", "case_revision_id", "workflow_id", "workflow_definition_version", "checkpoint_id", "checkpoint_sequence", "previous_checkpoint_id", "current_state", "resume_state", "workflow_version", "sla_deadline_at", "pending_intent_ids", "completed_intent_ids", "causation_event_id", "correlation_id", "content_sha256", "created_at"],
  "properties": {
    "schema_id": {"const": "https://weflow.local/contracts/v1/workflow-checkpoint.schema.json"},
    "schema_version": {"const": "v1"},
    "tenant_id": {"type": "string", "minLength": 1},
    "case_id": {"type": "string", "minLength": 1},
    "case_revision_id": {"type": "string", "minLength": 1},
    "workflow_id": {"type": "string", "minLength": 1},
    "workflow_definition_version": {"type": "string", "minLength": 1},
    "checkpoint_id": {"type": "string", "minLength": 1},
    "checkpoint_sequence": {"type": "integer", "minimum": 1},
    "previous_checkpoint_id": {"type": ["string", "null"]},
    "current_state": {"enum": ["RECEIVED", "TICKET_READY", "PAUSED", "WAITING_FOR_OPERATOR", "NEEDS_RECONCILIATION", "CANCELLED"]},
    "resume_state": {"enum": ["RECEIVED", "TICKET_READY", "WAITING_FOR_OPERATOR", "NEEDS_RECONCILIATION", "CANCELLED"]},
    "workflow_version": {"type": "integer", "minimum": 0},
    "sla_deadline_at": {"type": "string", "minLength": 1},
    "pending_intent_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "completed_intent_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "causation_event_id": {"type": ["string", "null"]},
    "correlation_id": {"type": "string", "minLength": 1},
    "content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "created_at": {"type": "string", "minLength": 1}
  }
}
