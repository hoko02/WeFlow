{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://weflow.local/contracts/v1/tool-result.schema.json",
  "title": "ToolResult",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "tenant_id", "case_id", "case_revision_id", "workflow_id", "checkpoint_id", "context_manifest_id", "tool_name", "tool_result_id", "tool_request_id", "evidence_id", "content_sha256", "redaction_classification", "recorded_at"],
  "properties": {
    "schema_id": {"const": "https://weflow.local/contracts/v1/tool-result.schema.json"},
    "schema_version": {"const": "v1"},
    "tenant_id": {"type": "string", "minLength": 1},
    "case_id": {"type": "string", "minLength": 1},
    "case_revision_id": {"type": "string", "minLength": 1},
    "workflow_id": {"type": "string", "minLength": 1},
    "checkpoint_id": {"type": "string", "minLength": 1},
    "context_manifest_id": {"type": "string", "minLength": 1},
    "tool_name": {"enum": ["crm", "monitoring", "knowledge"]},
    "tool_result_id": {"type": "string", "minLength": 1},
    "tool_request_id": {"type": "string", "minLength": 1},
    "evidence_id": {"type": "string", "minLength": 1},
    "content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "redaction_classification": {"const": "synthetic"},
    "recorded_at": {"type": "string", "minLength": 1}
  }
}
