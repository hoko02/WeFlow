{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://weflow.local/contracts/v1/qq-model-workflow-readiness.schema.json",
  "title": "QQModelWorkflowReadiness",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "mode", "environment", "app_id_hash", "tenant_id_hash", "group_openid_hash", "stage1_pairing_id", "handler_binding_id", "qq_capability_profile_hash", "model_capability_profile_hash", "stage3_profile_id", "stage3_profile_sha256", "provider_profile_sha256", "price_profile_sha256", "budget_profile_sha256", "selector_resolved", "profile_current", "network_contacted", "model_invocation", "case_mutation", "external_write_attempted", "ready", "production_ready"],
  "properties": {
    "schema_id": {"const": "https://weflow.local/contracts/v1/qq-model-workflow-readiness.schema.json"},
    "schema_version": {"const": "v1"},
    "mode": {"const": "qq-sandbox-live-model-workflow"},
    "environment": {"const": "sandbox"},
    "app_id_hash": {"$ref": "#/$defs/hash"},
    "tenant_id_hash": {"$ref": "#/$defs/hash"},
    "group_openid_hash": {"$ref": "#/$defs/hash"},
    "stage1_pairing_id": {"type": "string", "pattern": "^qqpair_[a-f0-9]{32}$"},
    "handler_binding_id": {"type": "string", "pattern": "^qqhbind_[a-f0-9]{32}$"},
    "qq_capability_profile_hash": {"$ref": "#/$defs/hash"},
    "model_capability_profile_hash": {"$ref": "#/$defs/hash"},
    "stage3_profile_id": {"const": "qq-stage3-api-503.v1"},
    "stage3_profile_sha256": {"$ref": "#/$defs/hash"},
    "provider_profile_sha256": {"$ref": "#/$defs/hash"},
    "price_profile_sha256": {"$ref": "#/$defs/hash"},
    "budget_profile_sha256": {"$ref": "#/$defs/hash"},
    "selector_resolved": {"type": "boolean"},
    "profile_current": {"type": "boolean"},
    "network_contacted": {"const": false},
    "model_invocation": {"const": false},
    "case_mutation": {"const": false},
    "external_write_attempted": {"const": false},
    "ready": {"type": "boolean"},
    "production_ready": {"const": false}
  },
  "$defs": {"hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
