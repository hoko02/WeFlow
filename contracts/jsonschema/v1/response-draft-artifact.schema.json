{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://weflow.local/contracts/v1/response-draft-artifact.schema.json",
  "title": "ResponseDraftArtifact",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "tenant_id", "case_id", "case_revision_id", "attempt_id", "producer_invocation_id", "artifact_id", "content_sha256", "media_type", "classification", "claim_evidence_summary", "retention_mode", "created_at", "expires_at", "producer", "artifact_sha256"],
  "properties": {
    "schema_id": {"const": "https://weflow.local/contracts/v1/response-draft-artifact.schema.json"}, "schema_version": {"const": "v1"}, "tenant_id": {"type": "string", "minLength": 1}, "case_id": {"type": "string", "minLength": 1}, "case_revision_id": {"type": "string", "minLength": 1}, "attempt_id": {"type": "string", "minLength": 1}, "producer_invocation_id": {"type": "string", "minLength": 1}, "artifact_id": {"type": "string", "minLength": 1}, "content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "media_type": {"const": "application/json"}, "classification": {"const": "synthetic_redacted"},
    "claim_evidence_summary": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"type": "object", "additionalProperties": false, "required": ["claim_sha256", "evidence_sha256"], "properties": {"claim_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "evidence_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}}},
    "retention_mode": {"enum": ["ephemeral", "redacted_diagnostics"]}, "created_at": {"type": "string", "minLength": 1}, "expires_at": {"type": "string", "minLength": 1}, "producer": {"const": "live-model-evaluation"}, "artifact_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
