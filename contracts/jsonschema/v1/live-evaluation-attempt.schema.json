{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://weflow.local/contracts/v1/live-evaluation-attempt.schema.json",
  "title": "LiveEvaluationAttempt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "tenant_id", "evaluation_session_id", "suite_id", "evaluation_task_id", "task_sha256", "oracle_sha256", "attempt_id", "attempt_index", "live_run_metrics_id", "metrics_sha256", "invocation_observation_ids", "candidate_binding_id", "verifier_outcome_id", "terminal_outcome", "hard_gates", "hard_gate_passed", "quality_dimensions", "quality_score", "failure_attribution", "complete", "approval_count", "delivery_count", "external_business_write_count", "attempt_sha256"],
  "properties": {
    "schema_id": {"const": "https://weflow.local/contracts/v1/live-evaluation-attempt.schema.json"}, "schema_version": {"const": "v1"}, "tenant_id": {"type": "string", "minLength": 1}, "evaluation_session_id": {"type": "string", "minLength": 1}, "suite_id": {"const": "live-pilot.v1"}, "evaluation_task_id": {"type": "string", "minLength": 1}, "task_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "oracle_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "attempt_id": {"type": "string", "minLength": 1}, "attempt_index": {"type": "integer", "minimum": 1, "maximum": 5}, "live_run_metrics_id": {"type": "string", "minLength": 1}, "metrics_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "invocation_observation_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "candidate_binding_id": {"type": ["string", "null"], "minLength": 1}, "verifier_outcome_id": {"type": ["string", "null"], "minLength": 1}, "terminal_outcome": {"enum": ["response_ready", "needs_information", "needs_operator", "tool_timeout", "budget_exhausted", "malformed_model_output", "policy_denied", "provider_outcome_unknown"]},
    "hard_gates": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["name", "passed", "reason_code"], "properties": {"name": {"type": "string", "minLength": 1}, "passed": {"type": "boolean"}, "reason_code": {"type": "string", "minLength": 1}}}}, "hard_gate_passed": {"type": "boolean"},
    "quality_dimensions": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["name", "score"], "properties": {"name": {"enum": ["expected_outcome", "action_validity", "tool_efficiency", "evidence_grounding", "response_structure"]}, "score": {"type": "integer", "minimum": 0, "maximum": 100}}}}, "quality_score": {"oneOf": [{"type": "integer", "minimum": 0, "maximum": 100}, {"const": "not_scored"}]}, "failure_attribution": {"type": ["string", "null"], "enum": [null, "configuration", "provider_network", "model_output", "model_quality", "harness_policy", "harness_verifier", "tool_fault", "budget", "evaluator_integrity"]}, "complete": {"const": true}, "approval_count": {"const": 0}, "delivery_count": {"const": 0}, "external_business_write_count": {"const": 0}, "attempt_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
