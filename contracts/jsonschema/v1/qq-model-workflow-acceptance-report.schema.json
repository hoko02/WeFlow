{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://weflow.local/contracts/v1/qq-model-workflow-acceptance-report.schema.json",
  "title": "QQModelWorkflowAcceptanceReport",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "report_type", "report_id", "report_sha256", "mode", "qq_provider_mode", "model_provider_mode", "app_id_hash", "tenant_id_hash", "group_openid_hash", "handler_binding_id", "stage3_profile_sha256", "qq_capability_profile_hash", "model_capability_profile_hash", "case_count", "acknowledgement_count", "notification_attempt_count", "assist_request_count", "model_invocation_count", "tool_result_count", "candidate_count", "private_preview_count", "approval_decision_count", "final_reply_count", "artifact_deletion_count", "model_usage", "failure_classification", "qq_intake_ack_verified", "handler_private_workflow_verified", "live_model_contact_verified", "candidate_verification_verified", "group_approval_verified", "final_provider_accepted", "artifact_deletion_verified", "network_contacted", "external_write_attempted", "customer_receipt_verified", "issue_resolution", "case_completion", "production_ready", "privacy"],
  "properties": {
    "schema_id": {"const": "https://weflow.local/contracts/v1/qq-model-workflow-acceptance-report.schema.json"},
    "schema_version": {"const": "v1"},
    "report_type": {"const": "weflow-qq-model-workflow-acceptance.v1"},
    "report_id": {"type": "string", "pattern": "^qqmwr_[a-f0-9]{32}$"},
    "report_sha256": {"$ref": "#/$defs/hash"},
    "mode": {"enum": ["offline-fake", "qq-model-integrated-live"]},
    "qq_provider_mode": {"enum": ["fake", "qq-sandbox-live"]},
    "model_provider_mode": {"enum": ["replay-fake", "openai-compatible-live"]},
    "app_id_hash": {"$ref": "#/$defs/hash"},
    "tenant_id_hash": {"$ref": "#/$defs/hash"},
    "group_openid_hash": {"$ref": "#/$defs/hash"},
    "handler_binding_id": {"type": "string", "pattern": "^qqhbind_[a-f0-9]{32}$"},
    "stage3_profile_sha256": {"$ref": "#/$defs/hash"},
    "qq_capability_profile_hash": {"$ref": "#/$defs/hash"},
    "model_capability_profile_hash": {"$ref": "#/$defs/hash"},
    "case_count": {"type": "integer", "minimum": 0, "maximum": 1},
    "acknowledgement_count": {"type": "integer", "minimum": 0, "maximum": 1},
    "notification_attempt_count": {"type": "integer", "minimum": 0, "maximum": 1},
    "assist_request_count": {"type": "integer", "minimum": 0, "maximum": 1},
    "model_invocation_count": {"type": "integer", "minimum": 0, "maximum": 7},
    "tool_result_count": {"type": "integer", "minimum": 0, "maximum": 3},
    "candidate_count": {"type": "integer", "minimum": 0, "maximum": 1},
    "private_preview_count": {"type": "integer", "minimum": 0, "maximum": 1},
    "approval_decision_count": {"type": "integer", "minimum": 0, "maximum": 1},
    "final_reply_count": {"type": "integer", "minimum": 0, "maximum": 1},
    "artifact_deletion_count": {"type": "integer", "minimum": 0},
    "model_usage": {"$ref": "#/$defs/usage"},
    "failure_classification": {"type": ["string", "null"], "minLength": 1, "maxLength": 96, "pattern": "^[a-z0-9._-]+$"},
    "qq_intake_ack_verified": {"type": "boolean"},
    "handler_private_workflow_verified": {"type": "boolean"},
    "live_model_contact_verified": {"type": "boolean"},
    "candidate_verification_verified": {"type": "boolean"},
    "group_approval_verified": {"type": "boolean"},
    "final_provider_accepted": {"type": "boolean"},
    "artifact_deletion_verified": {"type": "boolean"},
    "network_contacted": {"type": "boolean"},
    "external_write_attempted": {"type": "boolean"},
    "customer_receipt_verified": {"const": false},
    "issue_resolution": {"const": false},
    "case_completion": {"const": false},
    "production_ready": {"const": false},
    "privacy": {"type": "object", "additionalProperties": false, "required": ["credential_persisted", "raw_qq_identity_persisted", "provider_event_persisted", "transcript_persisted", "issue_plaintext_in_report", "draft_plaintext_in_report", "prompt_plaintext_persisted", "provider_body_persisted", "unrestricted_tool_output_persisted"], "properties": {"credential_persisted": {"const": false}, "raw_qq_identity_persisted": {"const": false}, "provider_event_persisted": {"const": false}, "transcript_persisted": {"const": false}, "issue_plaintext_in_report": {"const": false}, "draft_plaintext_in_report": {"const": false}, "prompt_plaintext_persisted": {"const": false}, "provider_body_persisted": {"const": false}, "unrestricted_tool_output_persisted": {"const": false}}}
  },
  "allOf": [
    {"if": {"properties": {"mode": {"const": "offline-fake"}}}, "then": {"properties": {"qq_provider_mode": {"const": "fake"}, "model_provider_mode": {"const": "replay-fake"}, "live_model_contact_verified": {"const": false}, "network_contacted": {"const": false}, "external_write_attempted": {"const": false}}}},
    {"if": {"properties": {"mode": {"const": "qq-model-integrated-live"}}}, "then": {"properties": {"qq_provider_mode": {"const": "qq-sandbox-live"}, "model_provider_mode": {"const": "openai-compatible-live"}, "network_contacted": {"const": true}}}}
  ],
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "usage": {"type": "object", "additionalProperties": false, "required": ["available", "provider_calls", "input_tokens", "output_tokens", "total_tokens", "estimated_cost", "currency", "provider_latency_ms", "end_to_end_latency_ms"], "properties": {"available": {"type": "boolean"}, "provider_calls": {"type": "integer", "minimum": 0}, "input_tokens": {"type": "integer", "minimum": 0}, "output_tokens": {"type": "integer", "minimum": 0}, "total_tokens": {"type": "integer", "minimum": 0}, "estimated_cost": {"type": "number", "minimum": 0}, "currency": {"const": "USD"}, "provider_latency_ms": {"type": "integer", "minimum": 0}, "end_to_end_latency_ms": {"type": "integer", "minimum": 0}}}
  }
}
