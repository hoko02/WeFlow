{
  "name": "@weflow/web-console",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite --host 127.0.0.1",
    "lint": "pnpm --filter @weflow/contracts build && tsc --noEmit -p tsconfig.json",
    "test": "pnpm --filter @weflow/contracts build && tsc -p tsconfig.status-check.json && node scripts/verify-foundation-status.mjs && vite build",
    "typecheck": "pnpm --filter @weflow/contracts build && tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@weflow/contracts": "workspace:*",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.0",
    "vite": "^7.0.0"
  }
}

